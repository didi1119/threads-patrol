{
  "name": "threads-patrol-workbench",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-27",
  "ai": { "binding": "AI" },
  "vars": { "COLLECT_ONLY_HOT_POSTS": "true" },
  "services": [{ "binding": "SCOUT_HEALTH", "service": "threads-patrol-scout-spike" }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "threads-patrol-workbench", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["17 * * * *"] }
}
